# n8n Configuration
N8N_HOST=your-domain-or-server-ip
N8N_PORT=5678
N8N_PROTOCOL=https

# Public URL used for webhooks
WEBHOOK_URL=https://your-domain-or-server-url/

# Timezone
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Generate a long, random encryption key for your n8n instance
N8N_ENCRYPTION_KEY=replace-with-a-strong-random-encryption-key

# Optional: configure these only if your deployment requires them
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=your-username
# N8N_BASIC_AUTH_PASSWORD=your-password